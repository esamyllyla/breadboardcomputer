                        	   275: COMMAND = $0270 ; "E" = Error, "R" = read, "W" = write
                        	   276: LOW_NYBBLE = $0271 ; For interpreter, if ascii is to be converted
                        	   277:                    ; to low or high nybble of a byte (0 or 1)
                        	   278: 
                        	   279: Arg0_H = $0272 ; Argument 0 used for read from location
                        	   280: Arg0_L = $0273
                        	   281: Arg1_H = $0274 ; Argument 1 used for read until this location
                        	   282: Arg1_L = $0275
                        	   283: 
                        	   284: Arg0_valid = $0276 ; throw error if these are invalid
                        	   285: Arg1_valid = $0277 ; in commands where they should be valid
