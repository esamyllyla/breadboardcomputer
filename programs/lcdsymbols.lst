                        	   329: skip_was_write: ; character is supposed to represent hex
00:8225 C952            	   330:     cmp #"R"
00:8227 D008            	   331:     bne skip_was_run
00:8229 A945            	   332:     lda #"E" ; E as execute, now R is occupied for Read
00:822B 8D7002          	   333:     sta COMMAND
00:822E 4C5582          	   334:     jmp inc_and_next
                        	   335: skip_was_run:
00:8231 C930            	   336:     cmp #$30    ; 0x30 is "0", character should be equal or higher
00:8233 301B            	   337:     bmi invalid_hex ; if A - 30 is negative, BMI branches
00:8235 C947            	   338:     cmp #$47    ; 0x46 is "F", character should be equal or lower
00:8237 1017            	   339:     bpl invalid_hex ; if A - 47 is zero or positive, BPL branches
