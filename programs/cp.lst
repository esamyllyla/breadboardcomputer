00:80C3 20B582          	   142:     jsr backspace
00:80C6 4C1981          	   143:     jmp end_kb_encoded_write
                        	   144: skip_clear:
00:80C9 E00E            	   145:     cpx #$e
00:80CB D006            	   146:     bne skip_shift
00:80CD 201D81          	   147:     jsr update_shift
00:80D0 4C1981          	   148:     jmp end_kb_encoded_write
                        	   149: skip_shift:
00:80D3 E00B            	   150:     cpx #$b
00:80D5 D008            	   151:     bne skip_enter
                        	   152: ; this happens when ENTER is pressed =======
00:80D7 A901            	   153:     lda #$1
00:80D9 8D5102          	   154:     sta enter_pressed
                        	   155: ; ==========================================
