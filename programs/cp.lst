                        	   238: skip_was_run:
00:8178 C930            	   239:     cmp #$30    ; 0x30 is "0", character should be equal or higher
00:817A 301B            	   240:     bmi invalid_hex ; if A - 30 is negative, BMI branches
00:817C C947            	   241:     cmp #$47    ; 0x46 is "F", character should be equal or lower
00:817E 1017            	   242:     bpl invalid_hex ; if A - 47 is zero or positive, BPL branches
