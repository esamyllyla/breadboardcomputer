Source: "cp.asm"
                        	     1: ; Control Program for 6502 breadboard computer
                        	     2: 
                        	     3: ; LCD-control pin variables
                        	     4: E  = %1000
                        	     5: RS = %10
                        	     6: ; LCD-display displays 2 or 4 lines
                        	     7: ; set N to 1 for 4 lines, 0 for 2 lines
                        	     8: N = 1
                        	     9: 
                        	    10: ; Keyboard matrix polling variables:
                        	    11: TMP = $0200
                        	    12: SHIFT = $0201
                        	    13: CURSOR_POSITION = $0202
                        	    14: TMP_KEYCODE = $0203
                        	    15: MONITOR_LINE_1 = $0210 ; 16 characters each
                        	    16:                        ; so line 1 occupies 0x0210 - 0x021f etc
                        	    17: MONITOR_LINE_2 = $0220 ; 0x0220 - 0x022f
                        	    18: MONITOR_LINE_3 = $0230 ; 0x0230 - 0x023f
                        	    19: MONITOR_LINE_4 = $0240 ; 0x0240 - 0x24f
                        	    20: 
                        	    21: ; User input interpreting variables:
                        	    22: COMMAND = $0250 ; "E" = Error, "R" = read, "W" = write
                        	    23: enter_pressed = $0251
                        	    24: tmp_input_byte = $0252
                        	    25: is_hex_letter = $0253
                        	    26: input_bytes_index = $0254
                        	    27: LOW_NYBBLE = $0255
                        	    28: 
                        	    29: RAL = $030 ; Read Address Low (pointer) for reading command   | POINTERS MUST BE ON ZERO PAGE
                        	    30: RAH = $031 ; Read Address High (pointer) for reading command  | ON 6502
                        	    31: input_bytes = $0260
                        	    32: 
                        	    33:     org $8000
                        	    34: 
